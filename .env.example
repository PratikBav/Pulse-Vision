# Email alert SMTP settings for PulseVision.
# Copy this file to .env (in the Pulse-Vision folder) and fill in your credentials.
# Never commit .env to version control.

# Example for Gmail (use a 16-character App Password, NOT your normal password):
PV_SMTP_HOST=smtp.gmail.com
PV_SMTP_PORT=587
PV_SMTP_SECURITY=starttls
PV_SMTP_USER=your.address@gmail.com
PV_SMTP_PASSWORD=your_16_char_app_password
PV_SMTP_FROM=your.address@gmail.com

# Firebase Admin SDK: set these in the server environment, not browser code.
# GOOGLE_APPLICATION_CREDENTIALS should point to a service-account file stored
# outside this repository, or use Google Application Default Credentials.
PV_FIREBASE_PROJECT_ID=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\path\service-account.json
